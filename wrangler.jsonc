{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Template config used by the "Deploy to Cloudflare" button and by `npm run deploy`.
  // No D1 database_id: wrangler reuses the Worker's existing DB binding, or finds/creates "heyflare-db" by name. For a manual setup, copy this file to
  // wrangler.local.jsonc, set your own ids/hostname there, and deploy with `npm run deploy:mine`.
  "name": "heyflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // Bundle migrations/*.sql as text so the Worker can apply them itself on first run.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/pubsub/*", "/mcp", "/mcp/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "heyflare-db", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "heyflare-attachments" }
  ],
  // One daily cron (dispatched by runCron in src/worker/index.ts): the retention sweep plus
  // backstops. Scheduled sends and bubble-ups fire as Workflow timers (TIMERS binding), Gmail watch
  // renewal is a SyncActor alarm, and missed Pub/Sub pushes are caught on app activity (GET /counts).
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": {
    "APP_NAME": "heyflare",
    "WORKER_NAME": "heyflare"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "workflows": [{ "name": "heyflare-timers", "binding": "TIMERS", "class_name": "TimerWorkflow" }],
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_ACTOR", "class_name": "SyncActor" }
    ]
  },
  "migrations": [
    { "tag": "v1-sync-actor", "new_sqlite_classes": ["SyncActor"] },
    { "tag": "v2-assistant-agent", "new_sqlite_classes": ["AssistantAgent"] },
    { "tag": "v3-remove-assistant-agent", "deleted_classes": ["AssistantAgent"] }
  ],
  // Optional: a custom hostname instead of *.workers.dev (a zone on your account with no existing DNS record for the host):
  // "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
  // Outbound for custom-domain mailboxes via Cloudflare Email Sending (Workers Paid + domain onboarded in Email Sending).
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
